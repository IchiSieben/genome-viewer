{
  "name": "alphagenome-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visor interactivo de predicciones de AlphaGenome. Sitio estatico, cero llamadas a la API.",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build && node scripts/inline-css.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "verify": "node scripts/serve-subfolder.mjs --run \"node scripts/verify.mjs\"",
    "verify:links": "node scripts/serve-subfolder.mjs --run \"node scripts/verify-links.mjs\"",
    "measure": "node scripts/serve-subfolder.mjs --run \"node scripts/measure.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "playwright": "^1.48.0"
  }
}
